#!name=RevenueCat
#!desc=适配 RevenueCat 订阅响应脚本，引用固定版本的上游源码。

[Header Rewrite]
http-request ^https://(api\.revenuecat\.com|api\.rc-backup\.com)/.+/(receipts$|subscribers/[^/]+$) header-del X-RevenueCat-ETag

[Script]
RevenueCat-Subscriber = type=http-response, pattern=^https://(api\.revenuecat\.com|api\.rc-backup\.com)/.+/(receipts$|subscribers/[^/]+$), requires-body=true, script-path=https://raw.githubusercontent.com/Yu9191/Rewrite/46fe48cdc168a8d115f204d3515103811676bc2a/Revenuecat.js

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
