#!name=RevenueCat
#!desc=适配 RevenueCat 订阅响应脚本，引用本仓库固定版本的脚本。

[Header Rewrite]
http-request ^https://(api\.revenuecat\.com|api\.rc-backup\.com)/.+/(receipts$|subscribers/[^/]+$) header-del X-RevenueCat-ETag

[Script]
RevenueCat-Subscriber = type=http-response, pattern=^https://(api\.revenuecat\.com|api\.rc-backup\.com)/.+/(receipts$|subscribers/[^/]+$), requires-body=true, script-path=https://raw.githubusercontent.com/Abinthur/Quantumult-X-For-Personal-Use/44e1afd4fb9015dcb1dd16a9e6930b415d965983/Surge/Revenuecat.js

[MITM]
hostname = %APPEND% api.revenuecat.com, api.rc-backup.com
